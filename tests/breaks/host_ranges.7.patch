# a root view with a few bytes left keeps its address, where a failed check's load reads past them
--- a/src/mullion/mullion_ranges.hpp
+++ b/src/mullion/mullion_ranges.hpp
@@ -125,7 +125,7 @@
 
 inline RootView
 RootViewBinding(uint64_t address, bool held, uint64_t end, uint64_t null_buffer) {
-  if (!held || end - address < kRootViewLoad)
+  if (!held)
     return {null_buffer, 0};
   return {address, std::min<uint64_t>(end - address, UINT32_MAX)};
 }
