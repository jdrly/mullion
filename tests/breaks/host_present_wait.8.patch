# a late wake moves nothing: the frame after it comes early
diff --git a/src/mullion/mullion_present_pacing.hpp b/src/mullion/mullion_present_pacing.hpp
--- a/src/mullion/mullion_present_pacing.hpp
+++ b/src/mullion/mullion_present_pacing.hpp
@@ -227,7 +227,7 @@
   // the wait for Next's deadline ended at `at`: a wake past the deadline moves the deadlines after it
   void
   Woke(uint64_t at) {
-    shown_ = std::max(shown_, at);
+    (void)at;
   }
 
 private:
