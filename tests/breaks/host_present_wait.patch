# the deadlines catch up: a late frame keeps them, and the frame after it comes early
diff --git a/src/mullion/mullion_present_pacing.hpp b/src/mullion/mullion_present_pacing.hpp
--- a/src/mullion/mullion_present_pacing.hpp
+++ b/src/mullion/mullion_present_pacing.hpp
@@ -216,10 +216,14 @@
       started_ = false;
       return 0;
     }
-    if (!started_ || now >= shown_ + period) {
+    if (!started_) {
       started_ = true, shown_ = now;
       return 0;
     }
+    if (now >= shown_ + period) {
+      shown_ += period;
+      return 0;
+    }
     shown_ += period;
     return shown_;
   }
